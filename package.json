{
  "name": "aleo-data-foundry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r build",
    "lint": "tsc --noEmit",
    "dev:api": "tsx packages/api/src/main.ts",
    "dev:ingestor": "tsx packages/ingestor/src/main.ts",
    "dev:backfill": "tsx packages/ingestor/src/backfill-main.ts",
    "dev:consumer": "tsx packages/ingestor/src/consumer-main.ts",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "tsx packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

# ─── Database ──────────────────────────────────────────────────
# Connection string for PostgreSQL. Format: postgresql://user:pass@host:port/db
# Default matches docker-compose.yml (foundry/foundry, db aleo_foundry).
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/aleo_foundry

# ─── Network ───────────────────────────────────────────────────
# Which Aleo network to ingest/serve. One of: testnet | mainnet
NETWORK=testnet

# ─── Ingestor ──────────────────────────────────────────────────
# Delay in ms between polling cycles (positive integer). 1000 = ~1 block/sec.
POLLING_INTERVAL_MS=1000
# Directory where the ingestion checkpoint file is persisted.
CHECKPOINT_DIR=./checkpoints

# ─── API Server ────────────────────────────────────────────────
# Port the Fastify server listens on (positive integer).
API_PORT=3000
# Comma-separated API keys (Bearer). Empty disables auth; when set, all data
# endpoints and the block stream require `Authorization: Bearer <key>`.
# /health stays public.
API_KEYS=
# Polling interval in ms for the SSE block stream (positive integer).
BLOCK_STREAM_INTERVAL_MS=1000

# ─── Future (Sprint 12) ────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OpenTelemetry metrics
# ALERT_LAG_THRESHOLD_BLOCKS=50                        # lag alert override